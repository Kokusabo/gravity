/*
  ================================================================
  ПРОЄКТ: Модель гравітаційного акумулятора енергії (Gravity Battery)
  ================================================================
  Мікроконтролер: ESP32 (NodeMCU-32S / WROOM-32 DevKit)
  Двигун:         GA25-370, 12V DC, 170 RPM (мотор-редуктор)
  Драйвер:        L298N (двомоторний H-Bridge модуль)
  Датчик:         INA226 (I2C, вимірювання напруги/струму/потужності)

  ----------------------------------------------------------------
  СХЕМА ПІДКЛЮЧЕННЯ (PINOUT)
  ----------------------------------------------------------------

  1) INA226  ->  ESP32 (I2C шина)
     ---------------------------------------
     VCC  -> 3.3V (ESP32)
     GND  -> GND  (спільна земля з усією схемою)
     SDA  -> GPIO 21 (ESP32 SDA за замовчуванням)
     SCL  -> GPIO 22 (ESP32 SCL за замовчуванням)
     VIN+ -> "+" живлення силового кола (від джерела 12V, до навантаження)
     VIN- -> "-" виходить далі на VM/двигун (INA226 стоїть ПОСЛІДОВНО
              у розриві силового проводу, щоб міряти струм двигуна)

  2) L298N  ->  ESP32 (керуючі сигнали, логіка 3.3V/5V сумісна)
     ---------------------------------------
     IN1  -> GPIO 27  (напрямок обертання, канал A)
     IN2  -> GPIO 26  (напрямок обертання, канал A)
     ENA  -> GPIO 25  (ШІМ, керування швидкістю каналу A)
     GND  -> GND (спільна земля ESP32 <-> L298N <-> джерело живлення)

     !!! ВАЖЛИВО ПРО ПЕРЕМИЧКИ (JUMPERS) НА L298N !!!
     - Перемичку "ENA" (5V-jumper) потрібно ЗНЯТИ, оскільки швидкістю
       ми керуємо програмно через ШІМ з GPIO25. Якщо перемичка стоїть -
       швидкість буде завжди максимальною і ledcWrite() не матиме ефекту.
     - Перемичку "ENB" можна залишити як є, якщо другий канал не використовується.
     - Перемичку 5V-регулятора (5V EN) залишаємо, ЯКЩО живлення силової
       частини 12V і потрібен внутрішній стабілізатор 5V для логіки L298N.
       Якщо ESP32 живить логіку окремо - перемичку можна зняти.

  3) СИЛОВА ЧАСТИНА
     ---------------------------------------
     Джерело 12V (+) -> INA226 VIN+  -> INA226 VIN- -> L298N "12V" вхід
     Джерело 12V (-) -> L298N GND (спільна земля з ESP32!)
     L298N OUT1, OUT2 -> клеми двигуна GA25-370

  ================================================================
*/

// ------------------- ПІДКЛЮЧЕННЯ БІБЛІОТЕК -------------------
#include <Wire.h>            // Бібліотека для роботи з шиною I2C
#include <INA226_WE.h>        // Бібліотека для датчика струму/напруги INA226
                              // (встановити через Library Manager: "INA226_WE" by Wolfgang Ewald)

// ------------------- НАЛАШТУВАННЯ I2C АДРЕСИ -------------------
#define INA226_ADDRESS 0x40   // Стандартна I2C-адреса INA226 (залежить від запаяних резисторів A0/A1)

// Створюємо об'єкт датчика, передаючи адресу на шині I2C
INA226_WE ina226 = INA226_WE(INA226_ADDRESS);

// ------------------- ПІНИ ПІДКЛЮЧЕННЯ L298N -------------------
const int PIN_IN1 = 27;       // Керування напрямком, вихід 1 драйвера
const int PIN_IN2 = 26;       // Керування напрямком, вихід 2 драйвера
const int PIN_ENA = 25;       // ШІМ-пін для регулювання швидкості (Enable A)

// ------------------- НАЛАШТУВАННЯ ШІМ (LEDC) -------------------
const int PWM_FREQ       = 5000;  // Частота ШІМ у Гц (5 кГц - комфортно для DC-моторів, без зайвого писку)
const int PWM_RESOLUTION = 8;     // Розрядність ШІМ: 8 біт => значення шпаруватості від 0 до 255
const int PWM_CHANNEL    = 0;     // Номер каналу ШІМ (використовуємо канал 0 з доступних 0-15 на ESP32)

// ------------------- ШВИДКОСТІ РУХУ (0-255) -------------------
const int SPEED_UP   = 200;   // Швидкість підйому вантажу (заряджання акумулятора)
const int SPEED_DOWN = 150;   // Швидкість спуску вантажу (розряджання, віддача енергії)

// ------------------- НАЛАШТУВАННЯ БЕЗПЕКИ -------------------
const float MAX_CURRENT_AMPS = 2.0;   // Максимально допустимий струм (А). Перевищення => аварійна зупинка
bool emergencyStopFlag = false;       // Прапорець аварійної зупинки (true = система заблокована)

// ------------------- ТАЙМІНГ ОПИТУВАННЯ ДАТЧИКА -------------------
unsigned long lastSensorReadTime = 0;      // Час останнього зчитування даних з INA226 (мс)
const unsigned long SENSOR_READ_INTERVAL = 500;  // Інтервал опитування датчика: кожні 500 мс

// ------------------- СТРУКТУРА ДЛЯ ЗБЕРІГАННЯ ДАНИХ ДАТЧИКА -------------------
struct SensorData {
  float busVoltage_V;    // Напруга на шині, Вольти
  float current_mA;      // Струм, міліампери
  float power_mW;        // Потужність, міліватти
};

SensorData currentReading;  // Глобальна змінна для зберігання останніх виміряних значень


// ================================================================
// ФУНКЦІЯ: initMotorDriver()
// Призначення: налаштування пінів напрямку та ініціалізація ШІМ-каналу
// ================================================================
void initMotorDriver() {
  pinMode(PIN_IN1, OUTPUT);        // Встановлюємо пін IN1 як вихід
  pinMode(PIN_IN2, OUTPUT);        // Встановлюємо пін IN2 як вихід

  // Нове API ШІМ для ESP32 Arduino Core 3.x (ledcAttach об'єднує setup+attach)
  // Якщо використовується стара версія ядра (2.x), розкоментуйте блок нижче
  // та закоментуйте рядок з ledcAttach.

  // --- Варіант для ESP32 Arduino Core 3.x і новіше ---
  ledcAttach(PIN_ENA, PWM_FREQ, PWM_RESOLUTION);  
  // ledcAttach автоматично прив'язує пін до вільного каналу ШІМ з заданою частотою і розрядністю

  // --- Варіант для ESP32 Arduino Core 2.x (розкоментувати за потреби) ---
  // ledcSetup(PWM_CHANNEL, PWM_FREQ, PWM_RESOLUTION);   // Налаштовуємо канал ШІМ: частота і розрядність
  // ledcAttachPin(PIN_ENA, PWM_CHANNEL);                // Прив'язуємо пін ENA до налаштованого каналу

  motorStop();  // Одразу після ініціалізації двигун повинен бути зупинений (безпечний стан)
}


// ================================================================
// ФУНКЦІЯ: initSensor()
// Призначення: ініціалізація шини I2C та датчика INA226
// ================================================================
void initSensor() {
  Wire.begin(21, 22);              // Ініціалізація I2C: SDA=GPIO21, SCL=GPIO22

  if (!ina226.init()) {
    // Якщо датчик не відповідає на шині - виводимо помилку і зупиняємо виконання
    Serial.println("ПОМИЛКА: Датчик INA226 не знайдено на шині I2C!");
    while (1) {
      delay(1000);                 // Зупиняємо програму назавжди - без датчика працювати небезпечно
    }
  }

  // Налаштування діапазону вимірювання: Range_16V - максимальний діапазон напруги шини
  ina226.setMeasureMode(CONTINUOUS);      // Безперервний режим вимірювання (автоматичне оновлення)
  ina226.setResistorRange(0.1, 3.2);      // Опір шунта (Ом) та максимальний очікуваний струм (А)
                                           // 0.1 Ом - типовий шунт на модулях INA226; 3.2A - запас по струму
  ina226.setAverage(AVERAGE_4);           // Усереднення по 4 вимірюваннях для зменшення шуму

  Serial.println("Датчик INA226 успішно ініціалізовано.");
}


// ================================================================
// ФУНКЦІЯ: readSensorData()
// Призначення: зчитує поточні значення напруги, струму та потужності
// Повертає: заповнену структуру SensorData
// ================================================================
SensorData readSensorData() {
  SensorData data;                                  // Локальна структура для результату

  data.busVoltage_V = ina226.getBusVoltage_V();      // Зчитуємо напругу шини у Вольтах
  data.current_mA   = ina226.getCurrent_mA();        // Зчитуємо струм у міліамперах
  data.power_mW      = ina226.getBusPower();         // Зчитуємо потужність у міліватах

  return data;                                       // Повертаємо заповнену структуру
}


// ================================================================
// ФУНКЦІЯ: printSensorData()
// Призначення: виводить дані датчика у Serial Monitor у зручному форматі
// ================================================================
void printSensorData(const SensorData &data) {
  Serial.print("Напруга: ");
  Serial.print(data.busVoltage_V, 3);      // Виводимо з точністю 3 знаки після коми
  Serial.print(" В | Струм: ");
  Serial.print(data.current_mA / 1000.0, 3);  // Переводимо мА в А для наочності
  Serial.print(" А | Потужність: ");
  Serial.print(data.power_mW / 1000.0, 3);    // Переводимо мВт у Вт
  Serial.println(" Вт");
}


// ================================================================
// ФУНКЦІЯ: motorUp()
// Призначення: обертає двигун у напрямку ПІДЙОМУ вантажу (заряджання)
// Параметр speed: значення ШІМ від 0 до 255
// ================================================================
void motorUp(int speed) {
  if (emergencyStopFlag) return;    // Якщо активна аварійна зупинка - ігноруємо команду

  digitalWrite(PIN_IN1, HIGH);      // IN1 = HIGH
  digitalWrite(PIN_IN2, LOW);       // IN2 = LOW  => обертання в "прямому" напрямку (підйом)

  ledcWrite(PIN_ENA, speed);        // Задаємо швидкість через ШІМ на піні ENA
  // Примітка: у новому API ledcWrite приймає номер піна (не каналу), якщо використано ledcAttach()
}


// ================================================================
// ФУНКЦІЯ: motorDown()
// Призначення: обертає двигун у зворотному напрямку (спуск/віддача енергії)
// Параметр speed: значення ШІМ від 0 до 255
// ================================================================
void motorDown(int speed) {
  if (emergencyStopFlag) return;    // Якщо активна аварійна зупинка - ігноруємо команду

  digitalWrite(PIN_IN1, LOW);       // IN1 = LOW
  digitalWrite(PIN_IN2, HIGH);      // IN2 = HIGH => обертання у зворотному напрямку (спуск)

  ledcWrite(PIN_ENA, speed);        // Задаємо швидкість через ШІМ на піні ENA
}


// ================================================================
// ФУНКЦІЯ: motorStop()
// Призначення: повна зупинка двигуна (гальмування "накоротко" через L298N)
// ================================================================
void motorStop() {
  digitalWrite(PIN_IN1, LOW);       // IN1 = LOW
  digitalWrite(PIN_IN2, LOW);       // IN2 = LOW  => обидва входи LOW = вільний вибіг/зупинка

  ledcWrite(PIN_ENA, 0);            // ШІМ = 0, живлення знято повністю
}


// ================================================================
// ФУНКЦІЯ: checkSafety()
// Призначення: перевіряє поточний струм і у разі перевищення порогу
//              виконує аварійну зупинку двигуна
// ================================================================
void checkSafety(const SensorData &data) {
  float currentAmps = data.current_mA / 1000.0;   // Переводимо струм з мА в А

  if (currentAmps > MAX_CURRENT_AMPS) {
    motorStop();                    // Негайно зупиняємо двигун (аварійне вимкнення)
    emergencyStopFlag = true;       // Встановлюємо прапорець блокування подальших команд руху

    Serial.println("=========================================");
    Serial.print("!!! АВАРІЙНА ЗУПИНКА !!! Струм перевищив поріг: ");
    Serial.print(currentAmps, 3);
    Serial.print(" А (поріг = ");
    Serial.print(MAX_CURRENT_AMPS, 1);
    Serial.println(" А). Ймовірне заклинювання двигуна.");
    Serial.println("=========================================");
  }
}


// ================================================================
// ФУНКЦІЯ: setup()
// Призначення: базова ініціалізація при старті плати
// ================================================================
void setup() {
  Serial.begin(115200);             // Запускаємо серійний порт на швидкості 115200 бод
  delay(500);                       // Невелика затримка для стабілізації живлення/монітора

  Serial.println("Ініціалізація системи гравітаційного акумулятора...");

  initMotorDriver();                // Налаштовуємо піни та ШІМ для L298N
  initSensor();                     // Налаштовуємо I2C та датчик INA226

  Serial.println("Система готова до роботи.");
  Serial.println("---------------------------------------------");

  // Демонстраційний запуск: піднімаємо вантаж (заряджання)
  motorUp(SPEED_UP);
}


// ================================================================
// ФУНКЦІЯ: loop()
// Призначення: головний робочий цикл програми
// ================================================================
void loop() {
  unsigned long currentTime = millis();   // Отримуємо поточний час роботи плати в мс

  // Перевіряємо, чи настав час для чергового опитування датчика (кожні 500 мс)
  if (currentTime - lastSensorReadTime >= SENSOR_READ_INTERVAL) {
    lastSensorReadTime = currentTime;           // Оновлюємо час останнього зчитування

    currentReading = readSensorData();          // Зчитуємо свіжі дані з INA226
    printSensorData(currentReading);            // Виводимо дані в Serial Monitor

    checkSafety(currentReading);                // Перевіряємо струм на предмет перевищення порогу
  }

  // ------------------------------------------------------------
  // Тут можна додати власну логіку зміни режимів (підйом/спуск),
  // наприклад, за командами з Serial або за таймером.
  // Приклад нижче показує ручне керування через Serial Monitor:
  // ------------------------------------------------------------
  if (Serial.available() > 0) {
    char command = Serial.read();     // Зчитуємо один символ команди

    switch (command) {
      case 'u':                       // Команда 'u' - підйом (заряджання)
      case 'U':
        if (!emergencyStopFlag) {
          Serial.println(">> Команда: ПІДЙОМ (заряджання)");
          motorUp(SPEED_UP);
        }
        break;

      case 'd':                       // Команда 'd' - спуск (розряджання)
      case 'D':
        if (!emergencyStopFlag) {
          Serial.println(">> Команда: СПУСК (віддача енергії)");
          motorDown(SPEED_DOWN);
        }
        break;

      case 's':                       // Команда 's' - зупинка двигуна
      case 'S':
        Serial.println(">> Команда: СТОП");
        motorStop();
        break;

      case 'r':                       // Команда 'r' - скидання аварійної зупинки
      case 'R':
        Serial.println(">> Скидання аварійного стану. Система розблокована.");
        emergencyStopFlag = false;    // Знімаємо блокування (робити тільки після усунення причини!)
        break;

      default:
        // Невідома команда - ігноруємо мовчки
        break;
    }
  }
}